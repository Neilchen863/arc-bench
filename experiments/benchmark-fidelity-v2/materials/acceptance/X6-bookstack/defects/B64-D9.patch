diff --git a/src/views/PageView.vue b/src/views/PageView.vue
index 2b297a6..207a43b 100644
--- a/src/views/PageView.vue
+++ b/src/views/PageView.vue
@@ -13,6 +13,9 @@ const error = ref('');
 onMounted(async () => {
   try {
     page.value = await api.get('pages', props.id);
+    const cache = JSON.parse(sessionStorage.getItem('page-cache') || '[]');
+    const at = cache.findIndex(c => c.id === props.id);
