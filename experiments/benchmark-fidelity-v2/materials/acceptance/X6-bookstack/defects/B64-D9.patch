diff --git a/src/views/BookView.vue b/src/views/BookView.vue
index b97cd0e..d61e9a4 100644
--- a/src/views/BookView.vue
+++ b/src/views/BookView.vue
@@ -15,6 +15,8 @@ onMounted(async () => {
     const [b, all] = await Promise.all([api.get('books', props.id), api.list('pages')]);
     book.value = b;
     pages.value = all.filter(p => p.bookId === props.id);
