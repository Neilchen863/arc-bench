diff --git a/src/style.css b/src/style.css
index 11d38d5..f645f08 100644
--- a/src/style.css
+++ b/src/style.css
@@ -62,3 +62,12 @@ a.entity-title:hover { color: var(--brand); text-decoration: underline; }
 .plain-list { padding-left: 1.2rem; }
 .rich { white-space: pre-wrap; }
 @media (max-width: 760px) { .layout { grid-template-columns: 1fr; } .card { padding: 1rem; } }
+
+.card-grid { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
+.page-card { position: relative; border: 1px solid var(--border); border-radius: 6px; padding: 12px; height: 100%; box-sizing: border-box; background: #fff; transition: box-shadow .15s; }
+.page-card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.12); }
+.page-card-title { font-size: 1rem; margin: 0 0 .4rem; }
+.page-card-title .stretched { color: inherit; text-decoration: none; }
+.page-card-title .stretched::after { content: ''; position: absolute; inset: 0; }
+.page-card-excerpt { margin: 0 0 .4rem; color: #555; font-size: .875rem; }
+.small { font-size: .8rem; }
