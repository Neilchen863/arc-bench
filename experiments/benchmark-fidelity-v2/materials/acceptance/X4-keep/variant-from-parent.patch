+.switch-thumb { position: absolute; top: -3px; left: -2px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.4); transition: left .15s; }
+.switch-row[aria-checked="true"] .switch-track { background: #a8c7fa; }
