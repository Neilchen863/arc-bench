diff --git a/src/components/LabelPicker.vue b/src/components/LabelPicker.vue
index 61bd36b..fbf2bbd 100644
--- a/src/components/LabelPicker.vue
+++ b/src/components/LabelPicker.vue
@@ -14,6 +14,9 @@ const labels = computed(() => [
   ...store.labels.filter(l => l.id === REMINDERS_ID),
   ...store.labels.filter(l => l.id !== REMINDERS_ID).sort((a, b) => a.name.localeCompare(b.name)),
 ])
+function toggle(id) {
+  chosen.value = chosen.value.includes(id) ? chosen.value.filter(x => x !== id) : [...chosen.value, id]
+}
 function finish() {
   // Keep only labels that still exist, preserving the order of the label list.
   emit('done', labels.value.map(l => l.id).filter(id => chosen.value.includes(id)))
@@ -27,11 +30,17 @@ function finish() {
       <p v-if="noteTitle" class="muted small">{{ noteTitle }}</p>
       <ul class="picker-list">
         <li v-for="label in labels" :key="label.id">
-          <label class="check-row">
-            <input v-model="chosen" type="checkbox" :value="label.id" />
+          <button
+            type="button"
+            class="switch-row"
+            role="switch"
+            :aria-checked="chosen.includes(label.id) ? 'true' : 'false'"
+            @click="toggle(label.id)"
+          >
             <AppIcon :name="label.id === REMINDERS_ID ? 'bell' : 'label'" :size="18" />
-            <span>{{ label.name }}</span>
-          </label>
+            <span class="grow">{{ label.name }}</span>
+            <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
+          </button>
         </li>
       </ul>
       <p v-if="labels.length === 1" class="muted small">Create more labels with Edit Labels in the sidebar.</p>
diff --git a/src/styles.css b/src/styles.css
index 4d38098..288b352 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -182,3 +182,10 @@ mark.match { background: var(--mark); color: inherit; border-radius: 2px; paddin
   .sidebar:not(.collapsed) .side-text { display: inline; }
   .main { padding: 16px; }
 }
+
+.switch-row { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 4px; border: 0; background: transparent; font: inherit; color: inherit; text-align: left; cursor: pointer; border-radius: 4px; }
+.switch-row:hover { background: rgba(0,0,0,.05); }
